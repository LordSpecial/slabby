# Slab API Configuration
# Copy this file to .env and fill in your actual values

# Your Slab API token (get from https://your-team.slab.com/settings/api)
SLAB_API_TOKEN=your-api-token-here

# Your Slab team subdomain (e.g., "acme" for acme.slab.com)
SLAB_TEAM=your-team-name

# Optional: enable integration tests (test/integration/) by setting this to
# the ID of the topic where integration tests can create scratch posts.
# The user maintains a topic named "MCP-Testing" for this purpose.
SLAB_TEST_TOPIC=
